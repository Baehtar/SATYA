# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Hugging Face API Key (For Image AI Detector & NLI models)
HF_API_KEY=your_huggingface_api_key_here
HF_IMAGE_MODEL=Organika/sdxl-detector

# ── Speech-to-text (voice notes) ──────────────────────────────────────────────
# Engine: whisper | gemini | auto  (auto = Whisper if a key below is set, else Gemini)
STT_ENGINE=auto
# Backend: api = OpenAI-compatible endpoint | local = openai-whisper pip package
WHISPER_BACKEND=api

# Whisper API key. Set ONE of these — precedence is top to bottom.
# OpenAI:  https://platform.openai.com/api-keys      (model whisper-1)
# Groq:    https://console.groq.com/keys             (model whisper-large-v3, free tier)
WHISPER_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides — leave blank to use the defaults for whichever key is set.
WHISPER_API_BASE=
WHISPER_API_MODEL=
# ISO-639-1 code to force a language (hi, en, ta). Blank = auto-detect.
WHISPER_LANGUAGE=
WHISPER_TIMEOUT=60
# Local backend only: tiny | base | small | medium | large
WHISPER_MODEL_SIZE=medium

# Search & Fact-Check APIs (Optional)
GOOGLE_FACTCHECK_API_KEY=
SERPAPI_KEY=

# OCR Configuration (easyocr, tesseract, gemini_vision)
OCR_ENGINE=gemini_vision
