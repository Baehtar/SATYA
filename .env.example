# ============================================================
#  SATYA — Environment Variables
#  Copy this file to .env and fill in your actual keys.
#  NEVER commit the .env file to Git.
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- SerpAPI for Google Lens reverse image search (https://serpapi.com) ---
SERPAPI_KEY=your_serpapi_key_here

# --- Google Fact Check Tools API (free, from Google Cloud Console) ---
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# --- App Settings ---
DEBUG=false
LOG_LEVEL=INFO

# --- Pipeline Timeouts (seconds) ---
IMAGE_PIPELINE_TIMEOUT=30
TEXT_PIPELINE_TIMEOUT=25
AUDIO_PIPELINE_TIMEOUT=35
TOTAL_TIMEOUT=58

# --- Confidence Thresholds ---
HIGH_CONFIDENCE_THRESHOLD=0.85
LOW_CONFIDENCE_THRESHOLD=0.60

# --- Model Settings ---
WHISPER_MODEL_SIZE=medium          # tiny | base | small | medium | large
AI_IMAGE_DETECTOR_MODEL=umm-maybe/AI-image-detector
USE_GPU=true

# --- Database ---
DATABASE_URL=sqlite:///./satya.db

# --- Dashboard ---
DASHBOARD_PORT=8080
