# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Hugging Face API Key (For Image AI Detector & NLI models)
HF_API_KEY=your_huggingface_api_key_here
HF_IMAGE_MODEL=Organika/sdxl-detector

# ── Speech-to-text (voice notes) ──────────────────────────────────────────────
# Engine: whisper | gemini | auto  (auto = Whisper if a key below is set, else Gemini)
STT_ENGINE=auto
# Backend: api = OpenAI-compatible endpoint | local = openai-whisper pip package
WHISPER_BACKEND=api

# Whisper API key. Set ONE of these — precedence is top to bottom.
# OpenAI:  https://platform.openai.com/api-keys      (model whisper-1)
# Groq:    https://console.groq.com/keys             (model whisper-large-v3, free tier)
WHISPER_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides — leave blank to use the defaults for whichever key is set.
WHISPER_API_BASE=
WHISPER_API_MODEL=
# ISO-639-1 code to force a language (hi, en, ta). Blank = auto-detect.
WHISPER_LANGUAGE=
WHISPER_TIMEOUT=60
# Local backend only: tiny | base | small | medium | large
WHISPER_MODEL_SIZE=medium

# Search & Fact-Check APIs (Optional)
GOOGLE_FACTCHECK_API_KEY=
SERPAPI_KEY=

# ── Reverse image search / provenance ─────────────────────────────────────────
# Google Cloud Vision Web Detection — the PRIMARY reverse-search provider.
# Enable the Vision API, then create an API key:
#   https://console.cloud.google.com/apis/library/vision.googleapis.com
# It accepts the image bytes directly, so the user's photo is never published.
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

REVERSE_SEARCH_ENABLED=true
REVERSE_SEARCH_TIMEOUT=20
REVERSE_SEARCH_MAX_MATCHES=10
DATE_EXTRACTION_MAX_PAGES=8
PAGE_FETCH_TIMEOUT=10

# SerpAPI Google Lens is the SECOND provider and reuses SERPAPI_KEY above.
# ⚠️ Lens searches an image by URL, so enabling it means publishing the user's
# image where SerpAPI can fetch it. Leave both blank to run Vision only.
# PUBLIC_IMAGE_BASE_URL: public base URL under which submitted images are served.
PUBLIC_IMAGE_BASE_URL=
# Or allow a direct upload to SerpAPI (also sends the image to a third party):
SERPAPI_LENS_ALLOW_UPLOAD=false

# OCR Configuration (easyocr, tesseract, gemini_vision)
OCR_ENGINE=gemini_vision
